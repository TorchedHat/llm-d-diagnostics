#!/bin/bash
# Cluster configuration template for llm-d diagnostics toolkit
#
# Copy this file:
#   cp examples/env.sh.example clusters/my-cluster/env.sh
#
# Edit with your cluster-specific values, then:
#   source clusters/my-cluster/env.sh
#   ./scripts/deploy.sh clusters/my-cluster
#   ./toolkit/run.sh characterize

# --- Required ---

# Kubernetes namespace (must exist, you need at least edit access)
export NS=my-namespace

# Model to serve (HuggingFace model ID)
export MODEL="microsoft/Phi-3-mini-4k-instruct"

# Where to store experiment results (relative to repo root)
export DATA_DIR="clusters/my-cluster/data"

# --- Model configuration ---

export MAX_MODEL_LEN=2048
export GPU_MEMORY_UTILIZATION=0.85
export DTYPE=float16

# --- Images ---

# vLLM engine image (must include NIXL support for disaggregated mode)
export VLLM_IMAGE="vllm/vllm-openai:v0.31.0"

# llm-d routing sidecar image
export SIDECAR_IMAGE="ghcr.io/llm-d/llm-d-router-disagg-sidecar:v0.11.0"

# GPU allocation supports DRA and classic NVIDIA device plugins.
# DRA uses the namespaced ResourceClaimTemplate gpu-<GPU_COUNT> (for example,
# gpu-1). deploy.sh reuses an existing template or creates one from
# GPU_DEVICE_CLASS.
export GPU_ALLOCATION_MODE="dra"
export GPU_COUNT=1
# export GPU_DEVICE_CLASS="gpu.nvidia.com"

# For clusters using the classic NVIDIA device plugin instead of DRA, use:
# export GPU_ALLOCATION_MODE="classic"
# export GPU_RESOURCE_NAME="nvidia.com/gpu"

# The v0.11.0 sidecar defaults to secure proxy mode; the deployment script
# disables it for in-cluster HTTP by default. Set https to enable its TLS
# listener and make toolkit clients use HTTPS.
export SIDECAR_SCHEME="http"

# --- Optional llm-d EPP / Gateway API integration ---
# Requires an existing Gateway whose controller supports InferencePool backends.
# export EPP_GATEWAY_NAME="inference-gateway"
# export EPP_GATEWAY_NAMESPACE="$NS"
# export EPP_ROUTER_VERSION="v0.11.0"
# export EPP_RELEASE_NAME="llm-d-epp"
# After deployment, set EPP_URL to the Gateway address and OpenAI endpoint.
# export EPP_URL="http://<gateway-address>/v1/completions"
# export EPP_METRICS_URL="http://llm-d-epp-epp:9090"
# ROUTING_MODE=epp makes exp4 fault probes use EPP. Other routing experiments
# add EPP comparison arms whenever EPP_URL is configured.
# export ROUTING_MODE="manual"

# --- Storage ---

# PVC for model weights — needs RWX if using pod anti-affinity
export MODEL_CACHE_SIZE="50Gi"
export STORAGE_CLASS=""  # Leave empty for cluster default

# --- Topology ---

# Number of prefill and decode replicas
# Minimum: 1P+1D for disaggregated mode
# Recommended: 2P+2D for redundancy and fault tolerance testing
export PREFILL_REPLICAS=1
export DECODE_REPLICAS=2

# --- In-cluster URLs (auto-generated by deploy.sh) ---

# Prefill service (headless, DNS round-robin across replicas)
export PREFILL_HOST="vllm-prefill-svc.${NS}.svc.cluster.local:8000"
